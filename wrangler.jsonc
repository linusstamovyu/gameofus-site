// Cloudflare Workers static-assets deploy. Its presence stops `wrangler deploy` from
// trying to auto-configure the Vite project, which refuses Vite 5.
{
  "name": "gameofus-site",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
